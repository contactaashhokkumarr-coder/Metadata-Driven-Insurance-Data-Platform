                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Lookup_SQL_To_Landing').output.value",
                        "type": "Expression"
                    },
                    "batchCount": 1,
                    "activities": [
                        {
                            "name": "Copy_SQL_To_Landing",
                            "type": "Copy",
                            "dependsOn": [],
