                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT 'Agent'  AS table_name, 'agent'  AS landing_folder, 'Agent.csv'  AS file_name\nUNION ALL\nSELECT 'Branch' AS table_name, 'branch' AS landing_folder, 'Branch.csv' AS file_name\nUNION ALL\nSELECT 'Claim'  AS table_name, 'claim'  AS landing_folder, 'Claim.csv'  AS file_name;",
